# Foundry
out/
cache/
broadcast/

# Secrets — NOTE: this repo lives on a fuseblk mount where chmod does not persist, so every file
# here is world-readable. Never put a private key in this directory. Keys live in ~/.aug_run/.env
# (mode 0600). See README.
.env
.env.*
!.env.example
*.key
keystore/
*.mnemonic

# Node / Next / Vite
node_modules/
.next/
next-env.d.ts
dist/
.vite/
*.tsbuildinfo

# site/lib/generated/abis.ts is generated from Foundry's out/ by site/scripts/extract-abis.mjs, but
# it IS committed on purpose: out/ is ignored, so without it a fresh clone could not build the site
# without installing Foundry and running `forge build` first. Regenerate with `npm run abis`.
# Any other generated tree stays out.
/lib/generated/
/src/generated/

# Editor / OS
.DS_Store
.vscode/
.idea/
