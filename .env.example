# AUG//RUN — environment template
#
#   !!  DO NOT PUT A REAL PRIVATE KEY IN THIS DIRECTORY  !!
#
# This repo sits on a fuseblk mount where chmod is a no-op — every file here is
# world-readable to any user on the machine, and that cannot be fixed from
# inside the repo. Copy this file to ~/.aug_run/.env instead:
#
#     cp .env.example ~/.aug_run/.env
#     chmod 600 ~/.aug_run/.env
#     ${EDITOR:-nano} ~/.aug_run/.env
#
# bin/deploy.sh sources that path and refuses to run if its mode isn't 0600.

# Deployer key. Use a throwaway testnet wallet — never a wallet holding real funds.
# 0x-prefixed, 32 bytes.
PRIVATE_KEY=0x

# Deployment mode. MUST be false for any mainnet deploy (disables both faucets).
AUGRUN_TESTNET=true

# Optional role addresses. All default to the deployer when unset, which is what
# you want for a single-wallet test harness.
# TREASURY=0x
# AUG_CIRCULATING=0x
# PROTOCOL_RESERVE=0x
# LAUNCH_SEED=0x

# Deployed Drop address, for the keeper. bin/run-drop.sh fires the weekly Drop so
# that operators only ever press COLLECT — see DEPLOYMENTS.md for the address.
# DROP_ADDRESS=0x
